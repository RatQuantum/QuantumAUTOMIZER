{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--headless",
        "--isolated",
        "--executablePath=/opt/pw-browsers/chromium",
        "--chromeArg=--no-sandbox",
        "--viewport=1080x1920"
      ]
    },
    "blender": {
      "command": "uvx",
      "args": ["mcp-for-blender"]
    }
  }
}
